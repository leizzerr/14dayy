  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DoorExitTrigger
  hesitateDescription: "\u0414\u0432\u0435\u0440\u044C \u043D\u0430\u0440\u0443\u0436\u0443. \u041C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u0443\u0439\u0442\u0438... \u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u2014 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u0434\u0435\u0441\u044C \u0435\u0449\u0451 \u043D\u0435 \u0432\u0441\u0451 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E."
  readyDescription: "\u0414\u0432\u0435\u0440\u044C \u043D\u0430\u0440\u0443\u0436\u0443. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0433\u043E\u0442\u043E\u0432 \u0443\u0439\u0442\u0438. [Space] \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043F\u0435\u0449\u0435\u0440\u0443."
