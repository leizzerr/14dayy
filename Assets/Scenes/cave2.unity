  m_Script: {fileID: 11500000, guid: 2016b82c9761f4686a7b144e320c8543, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UsbFlashVase
  foundDescription: "\u0412 \u0432\u0430\u0437\u0435 \u043B\u0435\u0436\u0438\u0442 USB-\u0444\u043B\u0435\u0448\u043A\u0430, \u0430 \u0440\u044F\u0434\u043E\u043C \u0438\u0437 \u0441\u0442\u0435\u043D\u044B \u0442\u043E\u0440\u0447\u0438\u0442 \u0440\u0430\u0437\u044A\u0451\u043C \u0441 \u0443\u0445\u043E\u0434\u044F\u0449\u0438\u043C \u0432\u043D\u0443\u0442\u0440\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u043E\u043C."
  tryAgainDescription: "\u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0451 \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443?"
  finalDescription: "\u0424\u043B\u0435\u0448\u043A\u0430 \u0432\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430, \u0440\u0430\u0437\u044A\u0451\u043C \u0442\u0438\u0445\u043E \u0433\u0443\u0434\u0438\u0442."
  firstAttemptMessage: "\u0422\u044B \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0444\u043B\u0435\u0448\u043A\u0443 \u0432 \u0440\u0430\u0437\u044A\u0451\u043C... \u041D\u0435 \u0432\u0445\u043E\u0434\u0438\u0442."
  secondAttemptMessage: "\u0422\u044B \u043F\u0435\u0440\u0435\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0448\u044C \u0444\u043B\u0435\u0448\u043A\u0443 \u0438 \u043F\u0440\u043E\u0431\u0443\u0435\u0448\u044C \u0441\u043D\u043E\u0432\u0430... \u041E\u043F\u044F\u0442\u044C \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u0442."
  successMessage: "\u0422\u044B \u043F\u0435\u0440\u0435\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0448\u044C \u0435\u0451 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0438 \u0432\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C... \u0415\u0441\u0442\u044C! \u0424\u043B\u0435\u0448\u043A\u0430 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u0445\u043E\u0434\u0438\u0442."
  globalLightName: Global Light 2D
  globalLightColor: {r: 1, g: 1, b: 1, a: 1}
  globalLightIntensity: 1
