  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7bb470f31fc64d008efb878db22a33d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DepthCheckDoor
  blockedDescription: "\u0412\u043D\u0443\u0442\u0440\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u0435\u043C\u043D\u043E, \u0434\u043D\u0430 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0432\u0438\u0434\u043D\u043E. \u0421\u0442\u0440\u0430\u0448\u043D\u043E \u043F\u0440\u044B\u0433\u0430\u0442\u044C \u0432\u043D\u0438\u0437 \u2014 \u0432\u0434\u0440\u0443\u0433 \u0442\u0430\u043C \u043E\u0447\u0435\u043D\u044C \u0433\u043B\u0443\u0431\u043E\u043A\u043E. \u041D\u0430\u0434\u043E \u0431\u044B \u043D\u0430\u0439\u0442\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u0443\u0434\u0430, \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."
  checkedDescription: "\u0422\u044B \u0431\u0440\u043E\u0441\u0430\u0435\u0448\u044C \u043A\u0430\u043C\u0435\u043D\u044C \u0432\u043D\u0438\u0437. \u0427\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u043B\u044B\u0448\u0435\u043D \u0433\u043B\u0443\u0445\u043E\u0439 \u0441\u0442\u0443\u043A \u043E \u0437\u0435\u043C\u043B\u044E \u2014 \u043D\u0435 \u0442\u0430\u043A \u0443\u0436 \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u043E. \u041C\u043E\u0436\u043D\u043E \u0441\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F."
